          "cachedResultName": "Gemini 3.5 Flash Lite"
        },
        "messages": {
          "values": [
            {
              "content": "=You are an AI customer feedback analyst.\n\nAnalyze the following customer feedback:\n\n{{ $json.customer_feedback }}\n\nReturn ONLY a valid JSON object with these fields:\n\n{\n  \"sentiment\": \"Positive, Negative, or Neutral\",\n  \"urgency\": \"Low, Medium, or High\",\n  \"category\": \"Complaint, Question, Compliment, or Suggestion\",\n  \"summary\": \"One-sentence summary\",\n  \"suggested_reply\": \"Short, professional response\"\n}\n\nRules:\n- Be accurate and concise.\n- Use High urgency for serious complaints or immediate refund requests.\n- Do not promise refunds or actions that have not been approved.\n- Write everything in English.\n- Do not include markdown formatting or code blocks."
            }
          ]
        },
        "jsonOutput": true,
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        448,
        0
      ],
      "id": "25e0d734-38ad-4dad-99c0-b023746f46ce",
      "name": "Message a model"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const raw = item.json.content.parts[0].text;\n  const analysis = JSON.parse(raw);\n\n  return {\n    json: analysis\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        816,
        0
      ],
      "id": "490072b2-812d-400b-bc03-852eacaede76",
