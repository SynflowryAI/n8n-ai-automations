        "messages": {
          "values": [
            {
              "content": "=Analyze the following customer email and prepare a response.\n\nSubject: {{ $('Get a message').item.json.subject }}\n\nCustomer message:\n{{ $('Get a message').item.json.text }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "systemMessage": "You are a professional AI customer support assistant for Demo Store, a fictional online electronics retailer.  Your job is to analyze customer emails and prepare helpful, professional draft replies.  Business information: - Products: wireless headphones and phone accessories. - Return window: 14 days. - Business hours: Monday to Friday, 09:00–18:00. - Support language: English.  Rules: 1. Only use the business information provided. 2. Never invent order statuses, delivery dates, prices, or policies. 3. Never promise refunds or discounts. 4. Escalate complaints, sensitive requests, and questions requiring unavailable information. 5. Do not claim that an order has been checked unless actual order data is provided. 6. Always prepare a draft. Never claim to have sent an email. 7. Keep responses polite, concise, and professional.  Return only valid JSON with these fields: {   \"category\": \"order|refund|general|complaint|other\",   \"confidence\": 0.0,   \"needs_human\": true,   \"reason\": \"\",   \"subject\": \"\",   \"reply\": \"\" }"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        -400,
        -176
      ],
      "id": "497deb1c-73de-4e94-89c3-3a38be72978e",
      "name": "Message a model1"
    },
    {
      "parameters": {
        "jsCode": "\nreturn $input.all().map((item) => {\n  // Read the AI-generated response\n  const rawText = item.json.content.parts\n    .map(part => part.text || '')\n    .join('\\n')\n    .trim();\n\n  // Remove Markdown code fences if present\n  const cleanedText = rawText\n    .replace(/^```(?:json)?\\s*/i, '')\n    .replace(/\\s*```$/, '')\n    .trim();\n\n  // Convert the response into a JSON object\n  const result = JSON.parse(cleanedText);\n\n  // Validate required fields\n  const requiredFields = [\n    'category',\n    'confidence',\n    'needs_human',\n    'reason',\n    'subject',\n    'reply'\n  ];\n\n  for (const field of requiredFields) {\n    if (!(field in result)) {\n      throw new Error(`Missing required field: ${field}`);\n    }\n  }\n\n  return {\n    json: {\n      category: result.category,\n      confidence: result.confidence,\n      needs_human: result.needs_human,\n      reason: result.reason,\n      subject: result.subject,\n      reply: result.reply\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
