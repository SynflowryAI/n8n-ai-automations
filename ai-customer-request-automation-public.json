      "name": "Get row(s) in sheet"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "models/gemini-3.5-flash-lite",
          "mode": "list",
          "cachedResultName": "Gemini 3.5 Flash Lite"
        },
        "messages": {
          "values": [
            {
              "content": "={{ `You are a professional AI customer support assistant.\n\nAnalyze the following customer request and prepare a polite, concise English email reply.\n\nRules:\n- Never invent company policies, shipping dates, prices, or guarantees.\n- Never promise a refund or replacement without human approval.\n- If the request requires account-specific information, company policy, or human approval, set needs_human to true.\n- Return only valid JSON, without markdown or code fences.\n- Use exactly these fields: category, needs_human, subject, reply.\n- category must be one of: order, complaint, shipping, other.\n- needs_human must be a boolean.\n- Never claim that a request has been forwarded, escalated, approved, or completed unless that action has actually occurred.\n- If human review is needed, say that the request requires review without promising a specific outcome or response time.\n\nCustomer name: ${$json.customer_name}\nCustomer email: ${$json.email}\nCustomer request: ${$json.request}\n\nGenerate the JSON response now.` }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        -848,
        -912
      ],
      "id": "7aec1887-58a0-4412-a545-8a3e18ec66c2",
      "name": "Message a model"
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nreturn items.map((item, index) => {\n  // Extract the Gemini response\n  const raw = (item.json.content?.parts ?? [])\n    .filter(part => !part.thought && typeof part.text === 'string')\n    .map(part => part.text)\n    .join('');\n\n  if (!raw.trim()) {\n    throw new Error(`Missing Gemini response for item ${index}`);\n  }\n\n  // Remove optional Markdown code fences\n  const cleaned = raw\n    .replace(/^\\s*```(?:json)?\\s*/i, '')\n    .replace(/\\s*```\\s*$/, '')\n    .trim();\n\n  let result;\n\n  try {\n    result = JSON.parse(cleaned);\n  } catch (error) {\n    throw new Error(`Invalid JSON for item ${index}: ${error.message}`);\n  }\n\n  // Validate the AI response\n  const categories = ['order', 'complaint', 'shipping', 'other'];\n\n  if (\n    !categories.includes(result.category) ||\n    typeof result.needs_human !== 'boolean' ||\n    typeof result.subject !== 'string' ||\n    !result.subject.trim() ||\n    typeof result.reply !== 'string' ||\n    !result.reply.trim()\n  ) {\n    throw new Error(`Invalid AI response fields for item ${index}`);\n  }\n\n\nconst customer = $('Get row(s) in sheet').all()[index].json;\n\nreturn {\n  json: {\n    row_number: customer.row_number,\n    customer_name: customer.customer_name,\n    email: customer.email,\n    request: customer.request,\n    category: result.category,\n    needs_human: result.needs_human,\n    subject: result.subject,\n    reply: result.reply\n  },\n  pairedItem: { item: index }\n};\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -528,
        -704
      ],
      "id": "8f9b817e-1655-45a9-ab18-2f55ca13e55c",
